# PostgreSQL Database Connection String (Neon Serverless Pooled URL)
DATABASE_URL="postgresql://postgres:password@localhost:5432/client_ai_db?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/client_ai_db?schema=public"

# Public Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Gemini AI Configuration (Server-side ONLY - never prefix with NEXT_PUBLIC_)
AI_API_KEY="your_gemini_api_key_here"
AI_MODEL="gemini-flash-lite-latest"

# Meta WhatsApp Cloud API Configuration (Server-side ONLY - never prefix with NEXT_PUBLIC_)
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_VERIFY_TOKEN=""
WHATSAPP_APP_SECRET=""

# Mailgun Email Automation Configuration (Server-side ONLY - never prefix with NEXT_PUBLIC_)
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""
MAILGUN_REGION="US" # Options: US (api.mailgun.net), EU (api.eu.mailgun.net)
MAILGUN_FROM_EMAIL=""
MAILGUN_WEBHOOK_SIGNING_KEY=""

# Google Workspace / Gmail OAuth & Push Integration (Server-side ONLY)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/integrations/google/callback"
GMAIL_PUBSUB_TOPIC="projects/your-gcp-project-id/topics/gmail-inbound"
GMAIL_PUBSUB_VERIFICATION_TOKEN=""
GOOGLE_PUBSUB_WEBHOOK_URL="https://your-public-tunnel-or-domain.com/api/webhooks/google/pubsub"
NEXT_PUBLIC_GOOGLE_PUBSUB_WEBHOOK_URL="https://your-public-tunnel-or-domain.com/api/webhooks/google/pubsub"

# Authentication & Session Security (Server-side ONLY)
JWT_SECRET=""

# Token Storage Encryption Key (32-byte recommended; falls back to JWT_SECRET if not specified)
ENCRYPTION_SECRET=""

# Scheduled Watch Renewal Cron Secret (Server-side ONLY - required for /api/integrations/google/watch/renew)
CRON_SECRET=""
